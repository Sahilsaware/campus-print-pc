# Copy this file to ".env" (same folder) and fill it in. Never share or commit ".env".
# Tip: run  python make_keys.py  to generate strong random values.

# Shared secret between the server and the print PC agent (16+ characters).
# The agent's .env must contain the SAME value.
AGENT_KEY=kiosk_secure_agent_key_2008

# Signs admin login cookies (32+ random characters).
SECRET_KEY=kiosk_secret_key_2008

# Super admin login for /admin (password 10+ characters).
ADMIN_USER=admin
ADMIN_PASSWORD=Sahil@2008

# Prices in rupees per printed side.
RATE_BW=2
RATE_COLOR=10

# 1 = TEST mode: orders are accepted WITHOUT real payment (use only while testing).
# 0 = LIVE mode: real Razorpay payment; fill in the two keys below.
PAYMENT_TEST_MODE=1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set both to 1 when the site is served through nginx / Cloudflare over HTTPS.
BEHIND_PROXY=0
COOKIE_SECURE=0

# Only used by "python app.py" (local testing).
PORT=5000
